# Copy this file to `.env` and adjust the values.
# Database: `docker compose up -d --wait` exposes PostgreSQL 17 on port 5433.
DATABASE_URL="postgresql://kanban:kanban@localhost:5433/kanban?schema=public"
# JWT signing secret (32 random bytes recommended):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-random-64-character-hexadecimal-value"
# JWT expiration time (ms/jsonwebtoken format: 1h, 30m, 7d, etc.)
JWT_EXPIRES_IN="1h"
PORT=3000
