{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "maxWorkers": 1,
  "testTimeout": 20000,
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/generated/**",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/**/*.spec.ts"
  ],
  "coverageDirectory": "coverage-e2e"
}
