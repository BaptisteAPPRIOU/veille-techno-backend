{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "maxWorkers": 1,
  "testTimeout": 20000,
  "collectCoverageFrom": [
    "<rootDir>/../src/**/*.ts",
    "!<rootDir>/../src/generated/**",
    "!<rootDir>/../src/main.ts",
    "!<rootDir>/../src/**/*.module.ts",
    "!<rootDir>/../src/**/*.spec.ts"
  ],
  "coverageDirectory": "<rootDir>/../coverage-e2e"
}
